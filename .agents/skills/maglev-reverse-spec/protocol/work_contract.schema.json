{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reverse Work Contract",
  "type": "object",
  "required": [
    "schema_version",
    "work_contract_id",
    "project_id",
    "repository",
    "base_commit",
    "registry_path",
    "pack_id",
    "manifest_path",
    "manifest_digest",
    "pack_digest",
    "consumer_contract_version",
    "source_units",
    "target_profile_ref",
    "project_root",
    "module_root",
    "scope_bindings",
    "module_bindings",
    "module_map_digest",
    "permission_boundary",
    "batch",
    "prohibited",
    "evidence_refs",
    "confidence",
    "target_conflicts"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "work_contract_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "minLength": 7},
    "candidate_commit": {"type": "string", "minLength": 7},
    "registry_path": {"type": "string", "minLength": 1},
    "pack_id": {"type": "string", "minLength": 1},
    "manifest_path": {"type": "string", "minLength": 1},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pack_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "consumer_contract_version": {
      "type": "string",
      "const": "reality-template-effect-pack-consumer/v1"
    },
    "source_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "relative_path", "roles"],
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "roles": {
            "type": "array",
            "items": {
              "enum": ["intent", "design_protocol", "implementation", "verification"]
            },
            "minItems": 1
          },
          "exclusions": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "target_profile_ref": {
      "type": "object",
      "required": ["path", "profile_id", "profile_version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "profile_version": {"type": ["integer", "string"]}
      },
      "additionalProperties": true
    },
    "project_root": {"type": "string", "minLength": 1},
    "module_root": {"type": "string", "minLength": 1},
    "scope_bindings": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "module_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["module_id", "domain", "owner_slot", "module_root", "slot_index_path"],
        "properties": {
          "module_id": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "owner_slot": {"type": "string", "minLength": 1},
          "module_root": {"type": "string", "minLength": 1},
          "slot_index_path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "module_map_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "batch": {
      "type": "object",
      "required": ["batch_id", "module_ids"],
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "module_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "prohibited": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array"},
    "confidence": {"type": "string", "minLength": 1},
    "permission_boundary": {
      "type": "object",
      "required": [
        "static_read",
        "runtime_read",
        "business_write",
        "reality_write",
        "project_execution"
      ],
      "properties": {
        "static_read": {"const": true},
        "runtime_read": {"const": false},
        "business_write": {"const": false},
        "reality_write": {"const": false},
        "project_execution": {"const": false}
      },
      "additionalProperties": true
    },
    "target_conflicts": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "enum": ["replace", "merge", "block"]
          },
          {
            "type": "object",
            "required": ["exists"],
            "properties": {
              "exists": {"type": "boolean"},
              "decision": {"enum": ["replace", "merge", "block"]}
            },
            "allOf": [
              {
                "if": {"properties": {"exists": {"const": true}}},
                "then": {"required": ["decision"]}
              }
            ],
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
