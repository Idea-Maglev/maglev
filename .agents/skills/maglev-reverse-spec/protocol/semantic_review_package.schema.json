{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic Review Package",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "work_contract_digest",
    "pack_binding",
    "module_map_digest",
    "gate_a",
    "gate_b",
    "module",
    "reviewed_paths",
    "pages",
    "review_layers",
    "findings",
    "unknowns",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "package_id": {"type": "string", "minLength": 1},
    "work_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pack_binding": {
      "type": "object",
      "required": [
        "pack_id",
        "manifest_digest",
        "pack_digest",
        "consumer_contract_version"
      ],
      "properties": {
        "pack_id": {"type": "string", "minLength": 1},
        "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pack_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "consumer_contract_version": {
          "type": "string",
          "const": "reality-template-effect-pack-consumer/v1"
        }
      },
      "additionalProperties": true
    },
    "module_map_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gate_a": {
      "type": "object",
      "required": ["status", "digest"],
      "properties": {
        "status": {"const": "accepted"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    "gate_b": {
      "type": "object",
      "required": ["status", "digest"],
      "properties": {
        "status": {"const": "accepted"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    "module": {
      "type": "object",
      "required": [
        "module_id",
        "domain",
        "owner_slot",
        "module_root",
        "slot_index_path"
      ],
      "properties": {
        "module_id": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "owner_slot": {"type": "string", "minLength": 1},
        "module_root": {"type": "string", "minLength": 1},
        "slot_index_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "reviewed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "page_id",
          "target_scope",
          "target_path",
          "applicability",
          "knowledge_status",
          "fact_summary",
          "claim_refs",
          "source_refs",
          "unknowns",
          "deep_dive_refs"
        ],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "target_scope": {"type": "string", "minLength": 1},
          "target_path": {"type": "string", "minLength": 1},
          "applicability": {
            "enum": ["required", "conditional", "optional", "not_applicable"]
          },
          "knowledge_status": {
            "enum": ["established", "unknown", "not_established", "not_applicable"]
          },
          "fact_summary": {"type": "string"},
          "claim_refs": {"type": "array"},
          "source_refs": {"type": "array"},
          "unknowns": {"type": "array"},
          "deep_dive_refs": {"type": "array"}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "applicability": {
                  "enum": ["required", "conditional", "optional"]
                }
              },
              "required": ["applicability"]
            },
            "then": {
              "properties": {
                "source_refs": {"minItems": 1}
              }
            }
          },
          {
            "if": {
              "properties": {
                "knowledge_status": {"const": "established"}
              },
              "required": ["knowledge_status"]
            },
            "then": {
              "properties": {
                "claim_refs": {"minItems": 1},
                "deep_dive_refs": {"minItems": 1}
              }
            }
          },
          {
            "if": {
              "properties": {
                "knowledge_status": {
                  "enum": ["unknown", "not_established"]
                }
              },
              "required": ["knowledge_status"]
            },
            "then": {
              "properties": {
                "unknowns": {"minItems": 1}
              }
            }
          },
          {
            "if": {
              "properties": {
                "applicability": {"const": "not_applicable"}
              },
              "required": ["applicability"]
            },
            "then": {
              "properties": {
                "knowledge_status": {"const": "not_applicable"}
              }
            }
          },
          {
            "if": {
              "properties": {
                "knowledge_status": {"const": "not_applicable"}
              },
              "required": ["knowledge_status"]
            },
            "then": {
              "properties": {
                "applicability": {"const": "not_applicable"}
              }
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "review_layers": {
      "type": "object",
      "required": ["structure", "content", "confidence"],
      "properties": {
        "structure": {"$ref": "#/$defs/review_layer"},
        "content": {"$ref": "#/$defs/review_layer"},
        "confidence": {"$ref": "#/$defs/review_layer"}
      },
      "additionalProperties": true
    },
    "findings": {"type": "array"},
    "unknowns": {"type": "array"},
    "evidence_refs": {"type": "array"}
  },
  "$defs": {
    "review_layer": {
      "type": "object",
      "required": ["status", "findings"],
      "properties": {
        "status": {"enum": ["pass", "fail", "blocked", "not_proven"]},
        "findings": {"type": "array"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
